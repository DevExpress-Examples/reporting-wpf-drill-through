<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<add name="nwind" connectionString="XpoProvider=SQLite;Data Source=|DataDirectory|\nwind.db" />
	</connectionStrings>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
</configuration>